 /**
+ * ScratcHA: the add-on serves this editor and the Home blocks from the same
+ * origin. Trust only that one file, so it loads without a sandbox. A
+ * sandboxed copy could not send the Home Assistant ingress cookie.
+ * @param {string} url URL as a string.
+ * @returns {boolean} True if this is the ScratcHA extension from this origin
+ */
+const isScratcHAExtension = url => {
+    try {
+        const parsed = new URL(url);
+        return parsed.origin === location.origin && parsed.pathname.endsWith('/extension/scratcha.js');
+    } catch (e) {
+        return false;
+    }
+};
